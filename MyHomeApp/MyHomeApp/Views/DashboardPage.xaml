<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MyHomeApp.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MyHomeApp.ViewModels"
    Title="{localization:Translate DashboardTitle}"
    x:DataType="vm:DashboardViewModel"
    BackgroundColor="{toolkit:AppThemeResource Background}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{toolkit:AppThemeResource Background}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <!--  Connection Status Card  -->
            <Border
                Padding="0"
                BackgroundColor="{toolkit:AppThemeResource Primary}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="16, 10" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="{localization:Translate ConnectionStatus}"
                        TextColor="White" />
                    <Label
                        FontSize="14"
                        Text="{Binding ConnectionStatus}"
                        TextColor="White" />
                    
                    <HorizontalStackLayout Spacing="10" Margin="0,8,0,0">
                        <Button
                            BackgroundColor="{toolkit:AppThemeResource Secondary}"
                            Command="{Binding ReconnectCommand}"
                            Text="{localization:Translate Reconnect}"
                            TextColor="White"
                             />
                        <Button
                            BackgroundColor="{toolkit:AppThemeResource Accent}"
                            Command="{Binding RefreshCommand}"
                            Text="{localization:Translate Refresh}"
                            TextColor="White"
                            WidthRequest="120" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--  Indoor Card  -->
            <Border
                Padding="0"
                BackgroundColor="{toolkit:AppThemeResource Card}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource Gray500}"
                        Opacity="0.2"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Padding="24" Spacing="12">
                    <!--  Card Header  -->
                    <HorizontalStackLayout Spacing="12">
                        <Border
                            BackgroundColor="{toolkit:AppThemeResource Primary}"
                            HeightRequest="45"
                            StrokeThickness="0"
                            WidthRequest="45">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="🏠"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="{localization:Translate Indoor}"
                            TextColor="{toolkit:AppThemeResource TextPrimary}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!--  Error Alert  -->
                    <Border 
                        Padding="12"
                        BackgroundColor="#FFEBEE"
                        IsVisible="{Binding IndoorHasError}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label 
                                Text="⚠️" 
                                FontSize="18"
                                VerticalOptions="Center"/>
                            <Label 
                                Text="{Binding IndoorErrorMessage}"
                                TextColor="#C62828"
                                FontSize="14"
                                VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!--  Divider  -->
                    <BoxView
                        Margin="0,8,0,8"
                        BackgroundColor="{StaticResource Gray300}"
                        HeightRequest="1" />

                    <!--  Metrics Grid  -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="20">

                        <!--  Temperature  -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Temperature}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding IndoorTemperatureDisplay}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IndoorHasError}" Value="True">
                                        <Setter Property="TextColor" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IndoorHasError}" Value="False">
                                        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Primary}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>

                        <!--  Humidity  -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Humidity}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding IndoorHumidityDisplay}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IndoorHasError}" Value="True">
                                        <Setter Property="TextColor" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IndoorHasError}" Value="False">
                                        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Accent}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>

                    </Grid>

                    <!--  Last Update  -->
                    <Label
                        FontSize="12"
                        HorizontalOptions="End"
                        Opacity="0.7"
                        Text="{Binding IndoorLastUpdate}"
                        TextColor="{toolkit:AppThemeResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!--  Outdoor Card  -->
            <Border
                Padding="0"
                BackgroundColor="{toolkit:AppThemeResource Card}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource Gray500}"
                        Opacity="0.2"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Padding="24" Spacing="12">
                    <!--  Card Header  -->
                    <HorizontalStackLayout Spacing="12">
                        <Border
                            BackgroundColor="{toolkit:AppThemeResource Secondary}"
                            HeightRequest="45"
                            StrokeThickness="0"
                            WidthRequest="45">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="🌤️"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="{localization:Translate Outdoor}"
                            TextColor="{toolkit:AppThemeResource TextPrimary}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!--  Error Alert  -->
                    <Border 
                        Padding="12"
                        BackgroundColor="#FFEBEE"
                        IsVisible="{Binding OutdoorHasError}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label 
                                Text="⚠️" 
                                FontSize="18"
                                VerticalOptions="Center"/>
                            <Label 
                                Text="{Binding OutdoorErrorMessage}"
                                TextColor="#C62828"
                                FontSize="14"
                                VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!--  Divider  -->
                    <BoxView
                        Margin="0,8,0,8"
                        BackgroundColor="{StaticResource Gray300}"
                        HeightRequest="1" />

                    <!--  Metrics Grid  -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="20">

                        <!--  Temperature  -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Temperature}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding OutdoorTemperatureDisplay}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding OutdoorHasError}" Value="True">
                                        <Setter Property="TextColor" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding OutdoorHasError}" Value="False">
                                        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Primary}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>

                        <!--  Humidity  -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Humidity}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding OutdoorHumidityDisplay}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding OutdoorHasError}" Value="True">
                                        <Setter Property="TextColor" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding OutdoorHasError}" Value="False">
                                        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Accent}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>

                        <!--  Atmospheric Pressure (Full Width)  -->
                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Pressure}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding OutdoorPressureDisplay}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding OutdoorHasError}" Value="True">
                                        <Setter Property="TextColor" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding OutdoorHasError}" Value="False">
                                        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Tertiary}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>

                    </Grid>

                    <!--  Last Update  -->
                    <Label
                        FontSize="12"
                        HorizontalOptions="End"
                        Opacity="0.7"
                        Text="{Binding OutdoorLastUpdate}"
                        TextColor="{toolkit:AppThemeResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
