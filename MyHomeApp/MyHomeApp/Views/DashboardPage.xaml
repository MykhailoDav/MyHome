<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MyHomeApp.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MyHomeApp.ViewModels"
    Title="{localization:Translate DashboardTitle}"
    x:DataType="vm:DashboardViewModel"
    BackgroundColor="{toolkit:AppThemeResource Background}">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{toolkit:AppThemeResource Background}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <!--  Page Title  -->
            <Label
                Margin="0,10,0,20"
                FontAttributes="Bold"
                FontSize="32"
                Text="{localization:Translate DashboardTitle}"
                TextColor="{toolkit:AppThemeResource TextPrimary}" />

            <!--  Indoor Card  -->
            <Border
                Padding="0"
                BackgroundColor="{toolkit:AppThemeResource Card}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource Gray500}"
                        Opacity="0.2"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Padding="24" Spacing="16">
                    <!--  Card Header  -->
                    <HorizontalStackLayout Spacing="12">
                        <Border
                            BackgroundColor="{toolkit:AppThemeResource Primary}"
                            HeightRequest="48"
                            StrokeThickness="0"
                            WidthRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="🏠"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="{localization:Translate Indoor}"
                            TextColor="{toolkit:AppThemeResource TextPrimary}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!--  Divider  -->
                    <BoxView
                        Margin="0,8,0,8"
                        BackgroundColor="{StaticResource Gray300}"
                        HeightRequest="1" />

                    <!--  Metrics Grid  -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="20">

                        <!--  Temperature  -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Temperature}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding IndoorTemperatureDisplay}"
                                TextColor="{toolkit:AppThemeResource Primary}" />
                        </VerticalStackLayout>

                        <!--  Humidity  -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Humidity}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding IndoorHumidityDisplay}"
                                TextColor="{toolkit:AppThemeResource Accent}" />
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  Outdoor Card  -->
            <Border
                Padding="0"
                BackgroundColor="{toolkit:AppThemeResource Card}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource Gray500}"
                        Opacity="0.2"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Padding="24" Spacing="16">
                    <!--  Card Header  -->
                    <HorizontalStackLayout Spacing="12">
                        <Border
                            BackgroundColor="{toolkit:AppThemeResource Secondary}"
                            HeightRequest="48"
                            StrokeThickness="0"
                            WidthRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="🌤️"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="{localization:Translate Outdoor}"
                            TextColor="{toolkit:AppThemeResource TextPrimary}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!--  Divider  -->
                    <BoxView
                        Margin="0,8,0,8"
                        BackgroundColor="{StaticResource Gray300}"
                        HeightRequest="1" />

                    <!--  Metrics Grid  -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="20">

                        <!--  Temperature  -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Temperature}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding OutdoorTemperatureDisplay}"
                                TextColor="{toolkit:AppThemeResource Primary}" />
                        </VerticalStackLayout>

                        <!--  Humidity  -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Humidity}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding OutdoorHumidityDisplay}"
                                TextColor="{toolkit:AppThemeResource Accent}" />
                        </VerticalStackLayout>

                        <!--  Atmospheric Pressure (Full Width)  -->
                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Spacing="8">
                            <Label
                                FontSize="14"
                                Text="{localization:Translate Pressure}"
                                TextColor="{toolkit:AppThemeResource TextSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="28"
                                Text="{Binding OutdoorPressureDisplay}"
                                TextColor="{toolkit:AppThemeResource Tertiary}" />
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
