<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyHomeApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyHomeApp.Services"
    xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
    xmlns:pages="clr-namespace:MyHomeApp.Views"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="MyHome"
    Shell.FlyoutBehavior="Flyout">
    <ShellContent
        Title="{localization:Translate DashboardTitle}"
        ContentTemplate="{DataTemplate pages:DashboardPage}"
        Route="DashboardPage" />

    <Shell.FlyoutFooter>
        <VerticalStackLayout
            x:Name="SettingsPanel"
            Padding="20"
            x:DataType="local:SettingsService"
            BackgroundColor="{toolkit:AppThemeResource Card}"
            Spacing="20">

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="{localization:Translate Settings}"
                TextColor="{toolkit:AppThemeResource TextPrimary}" />

            <VerticalStackLayout Spacing="8">
                <Label
                    FontSize="16"
                    Text="{localization:Translate Theme}"
                    TextColor="{toolkit:AppThemeResource TextPrimary}" />

                <HorizontalStackLayout Spacing="20">
                    <RadioButton
                        x:Name="LightThemeRadio"
                        CheckedChanged="OnThemeChanged"
                        Content="{localization:Translate Light}"
                        TextColor="{toolkit:AppThemeResource TextPrimary}"
                        Value="Light" />

                    <RadioButton
                        x:Name="DarkThemeRadio"
                        CheckedChanged="OnThemeChanged"
                        Content="{localization:Translate Dark}"
                        TextColor="{toolkit:AppThemeResource TextPrimary}"
                        Value="Dark" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="12">
                <Label
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="{localization:Translate Language}"
                    TextColor="{toolkit:AppThemeResource TextPrimary}"
                    VerticalOptions="Center"
                    WidthRequest="100" />

                <Picker
                    x:Name="LanguagePicker"
                    Title="{localization:Translate Language}"
                    BackgroundColor="{toolkit:AppThemeResource Surface}"
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding AvailableLanguages}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                    TextColor="{toolkit:AppThemeResource TextPrimary}"
                    VerticalOptions="Center"
                    WidthRequest="150" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>